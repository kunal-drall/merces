{
  "name": "merces",
  "version": "0.1.0",
  "private": true,
  "description": "Merces Stage 2: integration and backend for the Mercery mechanism (Solana + Monad)",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "MERCES_TEST_DB=1 vitest run",
    "test:conformance": "vitest run --project conformance",
    "test:canary": "MERCES_TEST_DB=1 vitest run --project canary",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx packages/db/src/cli.ts migrate",
    "db:reset": "tsx packages/db/src/cli.ts reset",
    "dev:mock": "tsx packages/server/src/dev-mock.ts",
    "dev:api": "tsx packages/server/src/main.ts",
    "dev:indexer": "tsx packages/indexer/src/main.ts",
    "dev:keepers": "tsx packages/keepers/src/main.ts",
    "dev:verifier": "tsx packages/report-verifier/src/main.ts",
    "demo:cycle": "tsx packages/scenarios/src/demo-cycle.ts",
    "stage1:sync": "tsx packages/stage1-sync/src/cli.ts",
    "openapi:client": "pnpm openapi:build && tsx packages/client/src/generate.ts",
    "openapi:check": "tsx packages/server/src/openapi-check.ts",
    "openapi:build": "tsx packages/api/src/openapi/build.ts",
    "docs:events": "tsx packages/domain/src/write-events-doc.ts && tsx packages/domain/src/write-schema.ts",
    "postinstall": "node scripts/stage1-build.mjs",
    "stage1:build": "node scripts/stage1-build.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
