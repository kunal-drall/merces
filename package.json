{
  "name": "merces",
  "private": true,
  "version": "0.1.0",
  "description": "Merces Stage 1: Human Equity Unit programs (Solana) and contracts (EVM) with a shared reference implementation and parity vectors.",
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r --filter './packages/*' test",
    "vectors": "pnpm --filter @merces/reference vectors",
    "circuits:build": "bash circuits/scripts/build.sh",
    "evm:build": "cd evm && forge build",
    "evm:test": "cd evm && forge test",
    "solana:build": "bash solana/scripts/build.sh",
    "solana:test": "cd solana && cargo test --release",
    "lint": "pnpm -r --filter './packages/*' lint"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vitest": "5.0.3",
    "@types/node": "^22"
  }
}
