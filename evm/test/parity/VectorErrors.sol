pragma solidity ^0.8.30;

import "../../src/types/MercesErrors.sol";

/// @notice Canonical v1.1 error names (`packages/sdk/src/errors.ts`, generated) → EVM custom-error selectors. The
/// rejection reasons `InvalidClearingPrice`, `ClaimMismatch` and `InvalidWindowPrice` are not reverts (they are
/// recorded on the round); `TransferFeeNotZero` is Solana-only; `TermsFrozen`, `NothingToClaim`,
/// `WalletCapExceeded` and `InsufficientEscrow` have no EVM revert (no function writes frozen terms, zero claims
/// are no-ops, the wallet cap makes an order invalid instead of reverting, and an unfunded transfer fails in the
/// stablecoin itself).
library VectorErrors {
    function selector(string memory errName) internal pure returns (bytes4) {
        bytes32 h = keccak256(bytes(errName));
        if (h == keccak256("AmountOutOfRange")) return AmountOutOfRange.selector;
        if (h == keccak256("NotAdmin")) return NotAdmin.selector;
        if (h == keccak256("NotAllowlistManager")) return NotAllowlistManager.selector;
        if (h == keccak256("NotIssuer")) return NotIssuer.selector;
        if (h == keccak256("IssuerInactive")) return IssuerInactive.selector;
        if (h == keccak256("IssuanceStopped")) return RegistryErrors.IssuanceStopped.selector;
        if (h == keccak256("NotAllowlisted")) return NotAllowlisted.selector;
        if (h == keccak256("ParameterOutOfBounds")) return ParameterOutOfBounds.selector;
        if (h == keccak256("InvalidReleaseSchedule")) return InvalidReleaseSchedule.selector;
        if (h == keccak256("InvalidTerms")) return InvalidTerms.selector;
        if (h == keccak256("ContractHashMissing")) return ContractHashMissing.selector;
        if (h == keccak256("SeriesNotDraft")) return SeriesNotDraft.selector;
        if (h == keccak256("UnfavourableAmendment")) return UnfavourableAmendment.selector;
        if (h == keccak256("AmendmentAfterTerminal")) return AmendmentAfterTerminal.selector;
        if (h == keccak256("FxPairExists")) return FxPairExists.selector;
        if (h == keccak256("UnknownFxPair")) return UnknownFxPair.selector;
        if (h == keccak256("InvalidAttestorSignature")) return InvalidAttestorSignature.selector;
        if (h == keccak256("InvalidVerifierSignature")) return InvalidVerifierSignature.selector;
        if (h == keccak256("NewRaisesPaused")) return NewRaisesPaused.selector;
        if (h == keccak256("RaiseNotOpen")) return RaiseNotOpen.selector;
        if (h == keccak256("RaiseNotDraft")) return RaiseNotDraft.selector;
        if (h == keccak256("BidsExist")) return BidsExist.selector;
        if (h == keccak256("CommitPhaseClosed")) return CommitPhaseClosed.selector;
        if (h == keccak256("RevealPhaseClosed")) return RevealPhaseClosed.selector;
        if (h == keccak256("RevealNotStarted")) return RevealNotStarted.selector;
        if (h == keccak256("BidExists")) return BidExists.selector;
        if (h == keccak256("BidNotFound")) return BidNotFound.selector;
        if (h == keccak256("AlreadyRevealed")) return AlreadyRevealed.selector;
        if (h == keccak256("CommitmentMismatch")) return CommitmentMismatch.selector;
        if (h == keccak256("ZeroEscrow")) return ZeroEscrow.selector;
        if (h == keccak256("SettlementNotReady")) return SettlementNotReady.selector;
        if (h == keccak256("TallyInProgress")) return TallyInProgress.selector;
        if (h == keccak256("TallyIncomplete")) return TallyIncomplete.selector;
        if (h == keccak256("NotSettling")) return NotSettling.selector;
        if (h == keccak256("AlreadyProcessed")) return AlreadyProcessed.selector;
        if (h == keccak256("NotProcessed")) return NotProcessed.selector;
        if (h == keccak256("AlreadyDelivered")) return AlreadyDelivered.selector;
        if (h == keccak256("RaiseNotSettled")) return RaiseNotSettled.selector;
        if (h == keccak256("ReleasesPaused")) return ReleasesPaused.selector;
        if (h == keccak256("SeriesLate")) return SeriesLate.selector;
        if (h == keccak256("MintNotFinalized")) return MintNotFinalized.selector;
        if (h == keccak256("NothingVested")) return NothingVested.selector;
        if (h == keccak256("EarlyDrawDisabled")) return EarlyDrawDisabled.selector;
        if (h == keccak256("EarlyDrawNotApproved")) return EarlyDrawNotApproved.selector;
        if (h == keccak256("ExceedsProceeds")) return ExceedsProceeds.selector;
        if (h == keccak256("TerminalStatus")) return TerminalStatus.selector;
        if (h == keccak256("WrongPeriod")) return WrongPeriod.selector;
        if (h == keccak256("ReportTooEarly")) return ReportTooEarly.selector;
        if (h == keccak256("PaymentOutstanding")) return PaymentOutstanding.selector;
        if (h == keccak256("UnreportedPeriods")) return UnreportedPeriods.selector;
        if (h == keccak256("TierNotEnabled")) return TierNotEnabled.selector;
        if (h == keccak256("RouterPeriodNotClosed")) return RouterPeriodNotClosed.selector;
        if (h == keccak256("FxMismatch")) return FxMismatch.selector;
        if (h == keccak256("StalePrice")) return StalePrice.selector;
        if (h == keccak256("ConfidenceTooWide")) return ConfidenceTooWide.selector;
        if (h == keccak256("SnapshotAlreadyTaken")) return SnapshotAlreadyTaken.selector;
        if (h == keccak256("FxFallbackRequired")) return FxFallbackRequired.selector;
        if (h == keccak256("FxFallbackNotAllowed")) return FxFallbackNotAllowed.selector;
        if (h == keccak256("InvalidProof")) return InvalidProof.selector;
        if (h == keccak256("NothingDue")) return NothingDue.selector;
        if (h == keccak256("TrueUpOutstanding")) return TrueUpOutstanding.selector;
        if (h == keccak256("TrueUpYearInvalid")) return TrueUpYearInvalid.selector;
        if (h == keccak256("TrueUpAdjustmentTooLarge")) return TrueUpAdjustmentTooLarge.selector;
        if (h == keccak256("NoUnitsOutstanding")) return NoUnitsOutstanding.selector;
        if (h == keccak256("HolderNotRegistered")) return HolderNotRegistered.selector;
        if (h == keccak256("PauseNotRequested")) return PauseNotRequested.selector;
        if (h == keccak256("AlreadyPaused")) return AlreadyPaused.selector;
        if (h == keccak256("NotPaused")) return NotPaused.selector;
        if (h == keccak256("InvalidPauseEnd")) return InvalidPauseEnd.selector;
        if (h == keccak256("PauseTooLong")) return PauseTooLong.selector;
        if (h == keccak256("TooManyPauses")) return TooManyPauses.selector;
        if (h == keccak256("LockupActive")) return LockupActive.selector;
        if (h == keccak256("NotRedeemed")) return NotRedeemed.selector;
        if (h == keccak256("NoTailDue")) return NoTailDue.selector;
        if (h == keccak256("TailEnded")) return TailEnded.selector;
        if (h == keccak256("NoRedeemedUnits")) return NoRedeemedUnits.selector;
        if (h == keccak256("SameAttestor")) return SameAttestor.selector;
        if (h == keccak256("RouterNotEnabled")) return RouterNotEnabled.selector;
        if (h == keccak256("DirectTransferForbidden")) return DirectTransferForbidden.selector;
        if (h == keccak256("WindowsDisabled")) return WindowsDisabled.selector;
        if (h == keccak256("WindowNotEligible")) return WindowNotEligible.selector;
        if (h == keccak256("WindowOpen")) return WindowOpen.selector;
        if (h == keccak256("WindowNotOpen")) return WindowNotOpen.selector;
        if (h == keccak256("OrderExists")) return OrderExists.selector;
        if (h == keccak256("OutOfOrder")) return OutOfOrder.selector;
        if (h == keccak256("UnarmedEscrowDeposit")) return UnarmedEscrowDeposit.selector;
        if (h == keccak256("InsufficientUnits")) return InsufficientUnits.selector;
        return bytes4(0);
    }

    /// @dev Reverse lookup for failure messages.
    function name(bytes4 sel) internal pure returns (string memory) {
        if (sel == AmountOutOfRange.selector) return "AmountOutOfRange";
        if (sel == NotAdmin.selector) return "NotAdmin";
        if (sel == NotAllowlistManager.selector) return "NotAllowlistManager";
        if (sel == NotIssuer.selector) return "NotIssuer";
        if (sel == IssuerInactive.selector) return "IssuerInactive";
        if (sel == RegistryErrors.IssuanceStopped.selector) return "IssuanceStopped";
        if (sel == NotAllowlisted.selector) return "NotAllowlisted";
        if (sel == ParameterOutOfBounds.selector) return "ParameterOutOfBounds";
        if (sel == InvalidReleaseSchedule.selector) return "InvalidReleaseSchedule";
        if (sel == InvalidTerms.selector) return "InvalidTerms";
        if (sel == ContractHashMissing.selector) return "ContractHashMissing";
        if (sel == SeriesNotDraft.selector) return "SeriesNotDraft";
        if (sel == UnfavourableAmendment.selector) return "UnfavourableAmendment";
        if (sel == AmendmentAfterTerminal.selector) return "AmendmentAfterTerminal";
        if (sel == FxPairExists.selector) return "FxPairExists";
        if (sel == UnknownFxPair.selector) return "UnknownFxPair";
        if (sel == InvalidAttestorSignature.selector) return "InvalidAttestorSignature";
        if (sel == InvalidVerifierSignature.selector) return "InvalidVerifierSignature";
        if (sel == NewRaisesPaused.selector) return "NewRaisesPaused";
        if (sel == RaiseNotOpen.selector) return "RaiseNotOpen";
        if (sel == RaiseNotDraft.selector) return "RaiseNotDraft";
        if (sel == BidsExist.selector) return "BidsExist";
        if (sel == CommitPhaseClosed.selector) return "CommitPhaseClosed";
        if (sel == RevealPhaseClosed.selector) return "RevealPhaseClosed";
        if (sel == RevealNotStarted.selector) return "RevealNotStarted";
        if (sel == BidExists.selector) return "BidExists";
        if (sel == BidNotFound.selector) return "BidNotFound";
        if (sel == AlreadyRevealed.selector) return "AlreadyRevealed";
        if (sel == CommitmentMismatch.selector) return "CommitmentMismatch";
        if (sel == ZeroEscrow.selector) return "ZeroEscrow";
        if (sel == SettlementNotReady.selector) return "SettlementNotReady";
        if (sel == TallyInProgress.selector) return "TallyInProgress";
        if (sel == TallyIncomplete.selector) return "TallyIncomplete";
        if (sel == NotSettling.selector) return "NotSettling";
        if (sel == AlreadyProcessed.selector) return "AlreadyProcessed";
        if (sel == NotProcessed.selector) return "NotProcessed";
        if (sel == AlreadyDelivered.selector) return "AlreadyDelivered";
        if (sel == RaiseNotSettled.selector) return "RaiseNotSettled";
        if (sel == ReleasesPaused.selector) return "ReleasesPaused";
        if (sel == SeriesLate.selector) return "SeriesLate";
        if (sel == MintNotFinalized.selector) return "MintNotFinalized";
        if (sel == NothingVested.selector) return "NothingVested";
        if (sel == EarlyDrawDisabled.selector) return "EarlyDrawDisabled";
        if (sel == EarlyDrawNotApproved.selector) return "EarlyDrawNotApproved";
        if (sel == ExceedsProceeds.selector) return "ExceedsProceeds";
        if (sel == TerminalStatus.selector) return "TerminalStatus";
        if (sel == WrongPeriod.selector) return "WrongPeriod";
        if (sel == ReportTooEarly.selector) return "ReportTooEarly";
        if (sel == PaymentOutstanding.selector) return "PaymentOutstanding";
        if (sel == UnreportedPeriods.selector) return "UnreportedPeriods";
        if (sel == TierNotEnabled.selector) return "TierNotEnabled";
        if (sel == RouterPeriodNotClosed.selector) return "RouterPeriodNotClosed";
        if (sel == FxMismatch.selector) return "FxMismatch";
        if (sel == StalePrice.selector) return "StalePrice";
        if (sel == ConfidenceTooWide.selector) return "ConfidenceTooWide";
        if (sel == SnapshotAlreadyTaken.selector) return "SnapshotAlreadyTaken";
        if (sel == FxFallbackRequired.selector) return "FxFallbackRequired";
        if (sel == FxFallbackNotAllowed.selector) return "FxFallbackNotAllowed";
        if (sel == InvalidProof.selector) return "InvalidProof";
        if (sel == NothingDue.selector) return "NothingDue";
        if (sel == TrueUpOutstanding.selector) return "TrueUpOutstanding";
        if (sel == TrueUpYearInvalid.selector) return "TrueUpYearInvalid";
        if (sel == TrueUpAdjustmentTooLarge.selector) return "TrueUpAdjustmentTooLarge";
        if (sel == NoUnitsOutstanding.selector) return "NoUnitsOutstanding";
        if (sel == HolderNotRegistered.selector) return "HolderNotRegistered";
        if (sel == PauseNotRequested.selector) return "PauseNotRequested";
        if (sel == AlreadyPaused.selector) return "AlreadyPaused";
        if (sel == NotPaused.selector) return "NotPaused";
        if (sel == InvalidPauseEnd.selector) return "InvalidPauseEnd";
        if (sel == PauseTooLong.selector) return "PauseTooLong";
        if (sel == TooManyPauses.selector) return "TooManyPauses";
        if (sel == LockupActive.selector) return "LockupActive";
        if (sel == NotRedeemed.selector) return "NotRedeemed";
        if (sel == NoTailDue.selector) return "NoTailDue";
        if (sel == TailEnded.selector) return "TailEnded";
        if (sel == NoRedeemedUnits.selector) return "NoRedeemedUnits";
        if (sel == SameAttestor.selector) return "SameAttestor";
        if (sel == RouterNotEnabled.selector) return "RouterNotEnabled";
        if (sel == DirectTransferForbidden.selector) return "DirectTransferForbidden";
        if (sel == WindowsDisabled.selector) return "WindowsDisabled";
        if (sel == WindowNotEligible.selector) return "WindowNotEligible";
        if (sel == WindowOpen.selector) return "WindowOpen";
        if (sel == WindowNotOpen.selector) return "WindowNotOpen";
        if (sel == OrderExists.selector) return "OrderExists";
        if (sel == OutOfOrder.selector) return "OutOfOrder";
        if (sel == UnarmedEscrowDeposit.selector) return "UnarmedEscrowDeposit";
        if (sel == InsufficientUnits.selector) return "InsufficientUnits";
        return "<non-canonical>";
    }
}
