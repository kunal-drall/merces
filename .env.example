# Copy to .env for local development. Nothing here is a secret.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/merces
PORT=3000
LOG_LEVEL=info

# Chain modes: mock | live | auto (default auto)
MERCES_CHAIN_SOLANA_MODE=auto
MERCES_CHAIN_EVM_MODE=auto

# Where Stage 1 artifacts live (directory containing handoff/manifest.json or stage1.map.json)
STAGE1_PATH=../merces-stage1

# Live chain RPCs (devnet / testnet only; mainnet is refused)
SOLANA_RPC_URL=https://api.devnet.solana.com
EVM_RPC_URL=
EVM_CHAIN_KEY=monad
EVM_CHAIN_ID=

# Key management: local | kms. Local signers are derived from a dev seed and are for development only.
# With any live chain, the API and keepers refuse these dev values (A-REV-9); the verifier refuses them unless
# MERCES_VERIFIER_DEV=true and every chain of its table is local.
MERCES_KMS_PROVIDER=local
MERCES_LOCAL_KEY_SEED=dev-seed-not-for-production

# Session token secret for the API (dev only)
MERCES_SESSION_SECRET=dev-session-secret-not-for-production
# Terms vault encryption key (32 bytes hex, dev only)
MERCES_VAULT_KEY_HEX=

# Report verifier (isolated process; devices POST zkTLS proofs to it directly)
REPORT_VERIFIER_URL=http://localhost:3100
REPORT_VERIFIER_PORT=3100
# Development only: let the standalone verifier accept the published dev seed above and the local chain ids (Solana
# localnet 104, EVM 31337) (it refuses both otherwise). The simulator only: with any other chain in
# MERCES_VERIFIER_CHAINS, a testnet included, the verifier refuses to start.
MERCES_VERIFIER_DEV=true
# The verifier's secp256k1 key (S4 WP6) behind the KMS port; its algorithm is configuration, never inferred
REPORT_VERIFIER_KEY_ID=report-verifier-1
# The address pin: the 20-byte address registered onchain as the verifier key. The verifier refuses to start when the
# KMS key's address differs. Required outside MERCES_VERIFIER_DEV=true; blank here (dev: whatever the dev seed derives).
REPORT_VERIFIER_ADDRESS=
# Retired verifier addresses whose prior-quarter attestations stay acceptable, each only for a quarter that ended at or
# before its retirement: JSON [{"address":"0x…","retiredAt":<unix seconds>}]. Never list a compromised key (RUNBOOK).
REPORT_VERIFIER_PREVIOUS_ADDRESSES=
# The chains the verifier signs for, as its own table (never taken from a request or from the API): JSON
# [{chain, family, chainKind, chainId, registry}], the registry as its chain-local address. Each domain must be on the
# signing allow-list (Solana testnet 102 / devnet 103, EVM testnets; never mainnet). These are the dev:mock simulators'
# own domains (chain keys solana and monad; a test keeps them equal to the simulators' ChainInfo.signing). The API's
# in-process verifier in mock mode derives its table from each simulator's ChainInfo.signing instead.
MERCES_VERIFIER_CHAINS='[{"chain":"solana","family":"solana","chainKind":1,"chainId":"104","registry":"62zg7zUPCY4at8HpJphApKhdNqREGFEWhvmGmLAZraWS"},{"chain":"monad","family":"evm","chainKind":2,"chainId":"31337","registry":"0xac2f2c7f7e0c0f6d49b1f85778169a2b667b5016"}]'

# Report proofs: Stage 1 Groth16 (default). `mock` also accepts forgeable mock proofs; simulator-only processes only.
MERCES_PROOF_SYSTEM=groth16

# Third-party providers (all default to mocks)
MERCES_ZKTLS_PROVIDER=mock
MERCES_IDENTITY_PROVIDER=mock
MERCES_ESIGN_PROVIDER=mock
MERCES_PRICE_FEED_PROVIDER=mock
MERCES_DEX_PROVIDER=mock
MERCES_EMAIL_PROVIDER=mock

# The non-reveal charge new series record, in whole bps within Stage 1's bounds (0-1000): a bid never revealed pays
# floor(deposit x rate / 10000) to the protocol fee collector when its raise settles. The owner's decision: there is no
# default. Left blank, no sealed-bid series can be created (build-create-series answers 409); a malformed or
# out-of-bounds value stops the API at startup. Tests and the vector runner set their own (RUNBOOK.md).
MERCES_NON_REVEAL_CHARGE_BPS=

# Feature flags (defaults shown)
MERCES_FLAG_TIER4=false
MERCES_FLAG_TRANSFER_WINDOWS=false
MERCES_FLAG_EARLY_DRAWS=false
MERCES_FLAG_SECONDARY_TRADING=false

# dev:mock
MERCES_SIM_KEY=sim                 # Postgres key prefix for persistent simulator state
MERCES_SEED=true                   # seed the 12-issuer synthetic cohort on first start
MERCES_SEED_QUARTERS=3             # how many 2026 quarters to report during seeding
MERCES_KEEPERS=true                # run the keeper scheduler in-process
KEEPER_TICK_MS=5000
INDEXER_POLL_MS=1000
MERCES_DEV_ROUTES=true             # /dev time travel and faucet (mock mode only)
MERCES_SIGNIN_DOMAIN=merces.local

# stage1:sync
STAGE1_SYNC_OUT=packages/stage1-sync/out
STAGE1_SYNC_GENERATED=packages/stage1-sync/generated
CONFORMANCE_CHAIN=simulator        # simulator | simulator:solana | simulator:monad | solana | evm:<chainKey>

# Pyth (live only)
PYTH_HERMES_URL=https://hermes.pyth.network
