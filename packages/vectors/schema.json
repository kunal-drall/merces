{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://merces.dev/schemas/parity-vector-2.json",
  "title": "Merces parity vector (schema 2, SPEC v1.1)",
  "description": "One scenario of SPEC.md §11. All integers are decimal strings, all byte strings are 0x-prefixed lowercase hex. `t` is the block time (unix seconds) the harness warps to before executing the step.",
  "type": "object",
  "required": ["name", "description", "schema", "specVersion", "generatedBy", "config", "actors", "keys", "seriesPrivate", "steps"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[0-9]{2}_[a-z0-9_]+$" },
    "description": { "type": "string" },
    "schema": { "const": 2 },
    "specVersion": { "const": "1.1" },
    "generatedBy": { "type": "string" },
    "config": {
      "type": "object",
      "required": ["parameters", "flags", "stablecoinDecimals", "chainDomainNote"],
      "additionalProperties": false,
      "properties": {
        "parameters": { "type": "object", "additionalProperties": { "$ref": "#/definitions/dec" } },
        "flags": {
          "type": "object",
          "required": ["newRaisesPaused", "windowsEnabled", "tier4Enabled"],
          "properties": { "newRaisesPaused": { "type": "boolean" }, "windowsEnabled": { "type": "boolean" }, "tier4Enabled": { "type": "boolean" } }
        },
        "stablecoinDecimals": { "const": 6 },
        "chainDomainNote": { "type": "string" }
      }
    },
    "actors": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "keys": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["seed", "derivation", "privateKey", "address", "role"],
        "properties": {
          "seed": { "type": "string" },
          "derivation": { "type": "string" },
          "privateKey": { "$ref": "#/definitions/hex32" },
          "address": { "$ref": "#/definitions/hex20" },
          "role": { "enum": ["attestor", "verifier"] }
        }
      }
    },
    "seriesPrivate": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["termsPlain", "termsCommitment"],
        "properties": {
          "termsPlain": {
            "type": "object",
            "required": ["theta", "rWad", "currencyCode", "indexingRule", "termsSalt"],
            "properties": {
              "theta": { "$ref": "#/definitions/dec" },
              "rWad": { "$ref": "#/definitions/dec" },
              "currencyCode": { "type": "integer" },
              "indexingRule": { "type": "integer" },
              "termsSalt": { "$ref": "#/definitions/dec" }
            }
          },
          "termsCommitment": { "$ref": "#/definitions/hex32" }
        }
      }
    },
    "steps": { "type": "array", "items": { "$ref": "#/definitions/step" } }
  },
  "definitions": {
    "dec": { "type": "string", "pattern": "^-?[0-9]+$" },
    "hex32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "hex20": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "hex": { "type": "string", "pattern": "^0x[0-9a-f]*$" },
    "nullableDec": { "oneOf": [{ "$ref": "#/definitions/dec" }, { "type": "null" }] },
    "nullableString": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
    "step": {
      "oneOf": [{ "$ref": "#/definitions/expectStep" }, { "$ref": "#/definitions/expectRevertStep" }, { "$ref": "#/definitions/actionStep" }]
    },
    "actionStep": {
      "allOf": [
        { "type": "object", "required": ["t", "op"], "properties": { "t": { "$ref": "#/definitions/dec" }, "note": { "type": "string" } } },
        { "$ref": "#/definitions/call" }
      ]
    },
    "expectRevertStep": {
      "type": "object",
      "required": ["t", "op", "call", "error"],
      "additionalProperties": false,
      "properties": {
        "t": { "$ref": "#/definitions/dec" },
        "op": { "const": "expect_revert" },
        "call": { "$ref": "#/definitions/call" },
        "error": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
        "note": { "type": "string" }
      }
    },
    "expectStep": {
      "type": "object",
      "required": ["t", "op"],
      "additionalProperties": false,
      "properties": {
        "t": { "$ref": "#/definitions/dec" },
        "op": { "const": "expect" },
        "series": { "type": "string" },
        "note": { "type": "string" },
        "balances": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["stable"],
            "properties": { "stable": { "$ref": "#/definitions/dec" }, "units": { "$ref": "#/definitions/dec" } }
          }
        },
        "treasury": { "$ref": "#/definitions/dec" },
        "vault": { "$ref": "#/definitions/dec" },
        "feeCollector": { "$ref": "#/definitions/dec" },
        "auctionEscrow": { "$ref": "#/definitions/dec" },
        "routerBalance": { "$ref": "#/definitions/dec" },
        "windowEscrowStable": { "$ref": "#/definitions/dec" },
        "windowEscrowUnits": { "$ref": "#/definitions/dec" },
        "ledger": { "$ref": "#/definitions/ledger" },
        "auction": { "$ref": "#/definitions/auction" },
        "window": { "$ref": "#/definitions/window" },
        "holders": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["pending", "redeemedUnits", "pendingUnits", "pendingRefund", "delivered"],
            "additionalProperties": false,
            "properties": {
              "pending": { "$ref": "#/definitions/dec" },
              "redeemedUnits": { "$ref": "#/definitions/dec" },
              "pendingUnits": { "$ref": "#/definitions/dec" },
              "pendingRefund": { "$ref": "#/definitions/dec" },
              "delivered": { "type": "boolean" }
            }
          }
        },
        "fx": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["sumWad", "count", "quarters"],
            "properties": {
              "sumWad": { "$ref": "#/definitions/dec" },
              "count": { "$ref": "#/definitions/dec" },
              "quarters": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": ["ok", "avgWad", "n", "flagged"],
                  "properties": { "ok": { "type": "boolean" }, "avgWad": { "$ref": "#/definitions/nullableDec" }, "n": { "$ref": "#/definitions/dec" }, "flagged": { "type": "boolean" } }
                }
              }
            }
          }
        }
      }
    },
    "ledger": {
      "type": "object",
      "description": "Series ledger view. `status` is the DERIVED status at `t` (§6.4). `carryWad` is the reference's exact WAD-scaled remainder (0 ≤ carryWad < units_outstanding); `carry` = floor(carryWad / WAD) is the SPEC's base-unit carry (0 in every vector).",
      "required": [
        "status", "raiseState", "mintFinalized", "unitsOutstanding", "unitsSold", "clearingPrice", "proceeds", "releasedTotal", "capPerUnit", "capMultipleWad",
        "termsCommitment", "amendmentNonce", "paidPerUnitWad", "netAccWad", "carryWad", "carry", "grossReceived", "feeCollected", "refundedToIssuer",
        "lastAcceptedPeriod", "lastPaidPeriod", "openDuePeriod", "openDueAmount", "routerCredit", "trueupNonce", "trueupDue", "trueupAttestedAt", "lastTrueupYear", "pauseNonce", "pauseCount", "pausedTotal",
        "formalNoticeEmittedFor", "redemptionPrice", "unitsAtRedemption", "tailCapPerUnit", "tailAccWad", "tailExhausted", "extinguishedAt", "finalAccWad", "finalUnits", "extinguishNonce"
      ],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["OnTime", "InGrace", "Late", "Paused", "Retired", "Redeemed", "Extinguished"] },
        "raiseState": { "enum": ["Draft", "Open", "Reveal", "Settling", "Settled", "Failed", "Cancelled"] },
        "mintFinalized": { "type": "boolean" },
        "unitsOutstanding": { "$ref": "#/definitions/dec" },
        "unitsSold": { "$ref": "#/definitions/dec" },
        "clearingPrice": { "$ref": "#/definitions/dec" },
        "proceeds": { "$ref": "#/definitions/dec" },
        "releasedTotal": { "$ref": "#/definitions/dec" },
        "capPerUnit": { "$ref": "#/definitions/dec" },
        "capMultipleWad": { "$ref": "#/definitions/dec" },
        "termsCommitment": { "$ref": "#/definitions/hex32" },
        "amendmentNonce": { "$ref": "#/definitions/dec" },
        "paidPerUnitWad": { "$ref": "#/definitions/dec" },
        "netAccWad": { "$ref": "#/definitions/dec" },
        "carryWad": { "$ref": "#/definitions/dec" },
        "carry": { "$ref": "#/definitions/dec" },
        "grossReceived": { "$ref": "#/definitions/dec" },
        "feeCollected": { "$ref": "#/definitions/dec" },
        "refundedToIssuer": { "$ref": "#/definitions/dec" },
        "lastAcceptedPeriod": { "$ref": "#/definitions/nullableDec" },
        "lastPaidPeriod": { "$ref": "#/definitions/nullableDec" },
        "openDuePeriod": { "$ref": "#/definitions/nullableDec" },
        "openDueAmount": { "$ref": "#/definitions/dec" },
        "routerCredit": { "$ref": "#/definitions/dec" },
        "trueupNonce": { "$ref": "#/definitions/dec" },
        "trueupDue": { "$ref": "#/definitions/dec" },
        "trueupAttestedAt": { "$ref": "#/definitions/dec" },
        "lastTrueupYear": { "$ref": "#/definitions/nullableDec" },
        "pauseNonce": { "$ref": "#/definitions/dec" },
        "pauseCount": { "$ref": "#/definitions/dec" },
        "pausedTotal": { "$ref": "#/definitions/dec" },
        "formalNoticeEmittedFor": { "$ref": "#/definitions/nullableDec" },
        "redemptionPrice": { "$ref": "#/definitions/dec" },
        "unitsAtRedemption": { "$ref": "#/definitions/dec" },
        "tailCapPerUnit": { "$ref": "#/definitions/dec" },
        "tailAccWad": { "$ref": "#/definitions/dec" },
        "tailExhausted": { "type": "boolean" },
        "extinguishedAt": { "$ref": "#/definitions/dec" },
        "finalAccWad": { "$ref": "#/definitions/dec" },
        "finalUnits": { "$ref": "#/definitions/dec" },
        "extinguishNonce": { "$ref": "#/definitions/dec" }
      }
    },
    "auction": {
      "type": "object",
      "description": "Raise state: bid counters, the current settlement round (a wrong proposal is RECORDED as rejected, not reverted) and the exact one-pass results.",
      "required": [
        "bidCount", "revealedCount", "validCount", "escrowTotal", "auctionEscrowUnits", "tallyRound", "roundRejected", "rejectionReason", "clearingPrice", "qAbove", "qAt", "R",
        "unitsSold", "proceeds", "unitsMinted", "bidsProcessed", "mintFinalized"
      ],
      "additionalProperties": false,
      "properties": {
        "bidCount": { "$ref": "#/definitions/dec" },
        "revealedCount": { "$ref": "#/definitions/dec" },
        "validCount": { "$ref": "#/definitions/dec" },
        "escrowTotal": { "$ref": "#/definitions/dec" },
        "auctionEscrowUnits": { "$ref": "#/definitions/dec" },
        "tallyRound": { "$ref": "#/definitions/dec" },
        "roundRejected": { "type": "boolean" },
        "rejectionReason": { "oneOf": [{ "enum": ["ClaimMismatch", "InvalidClearingPrice"] }, { "type": "null" }] },
        "clearingPrice": { "$ref": "#/definitions/dec" },
        "qAbove": { "$ref": "#/definitions/dec" },
        "qAt": { "$ref": "#/definitions/dec" },
        "R": { "$ref": "#/definitions/dec" },
        "unitsSold": { "$ref": "#/definitions/dec" },
        "proceeds": { "$ref": "#/definitions/dec" },
        "unitsMinted": { "$ref": "#/definitions/dec" },
        "bidsProcessed": { "$ref": "#/definitions/dec" },
        "mintFinalized": { "type": "boolean" }
      }
    },
    "window": {
      "type": "object",
      "description": "The series' current (or last) transfer window.",
      "required": ["period", "state", "tallyRound", "roundRejected", "clearingPrice", "branch", "matchedUnits", "escrowStable", "escrowUnits"],
      "additionalProperties": false,
      "properties": {
        "period": { "$ref": "#/definitions/dec" },
        "state": { "enum": ["Commit", "Reveal", "Settling", "Settled", "NoMatch", "Done"] },
        "tallyRound": { "$ref": "#/definitions/dec" },
        "roundRejected": { "type": "boolean" },
        "clearingPrice": { "$ref": "#/definitions/nullableDec" },
        "branch": { "oneOf": [{ "enum": ["SupplyLimited", "DemandLimited"] }, { "type": "null" }] },
        "matchedUnits": { "$ref": "#/definitions/dec" },
        "escrowStable": { "$ref": "#/definitions/dec" },
        "escrowUnits": { "$ref": "#/definitions/dec" }
      }
    },
    "proof": {
      "type": "object",
      "required": ["pi_a", "pi_b", "pi_c", "protocol", "curve"],
      "properties": {
        "pi_a": { "type": "array", "items": { "$ref": "#/definitions/dec" }, "minItems": 3, "maxItems": 3 },
        "pi_b": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/definitions/dec" }, "minItems": 2, "maxItems": 2 }, "minItems": 3, "maxItems": 3 },
        "pi_c": { "type": "array", "items": { "$ref": "#/definitions/dec" }, "minItems": 3, "maxItems": 3 },
        "protocol": { "const": "groth16" },
        "curve": { "const": "bn128" }
      }
    },
    "call": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "enum": [
            "fund", "allowlist", "register_issuer", "deactivate_issuer", "register_attestor", "revoke_attestor", "register_verifier_key", "revoke_verifier_key",
            "set_flags", "set_fx_pair", "create_series", "set_contract_hash", "stop_issuance", "resume_issuance", "open_raise", "cancel_raise", "commit_bid",
            "reveal_bid", "begin_settlement", "finalize_settlement", "process_bid", "deliver_bid", "claim_release", "set_release_pause", "submit_report", "pay",
            "submit_trueup", "pay_trueup", "claim", "register_holder", "burn_retired", "retire_if_capped", "crank_status", "request_pause", "withdraw_pause_request",
            "approve_pause", "end_pause", "route_income", "close_router_period", "fx_snapshot", "redeem", "claim_redemption", "claim_tail", "extinguish", "claim_final",
            "amend_terms", "open_window", "commit_ask", "window_commit_bid", "reveal_order", "begin_window_settlement", "finalize_window", "process_orders", "transfer_units"
          ]
        },
        "actor": { "type": "string" },
        "series": { "type": "string" },
        "priorIncomeCommitment": { "$ref": "#/definitions/hex32" },
        "incomeCommitment": { "$ref": "#/definitions/hex32" },
        "proof": { "$ref": "#/definitions/proof" },
        "publicSignals": { "type": "array", "items": { "$ref": "#/definitions/dec" }, "minItems": 6, "maxItems": 6 },
        "proofEvm": {
          "type": "object",
          "required": ["pA", "pB", "pC", "pubSignals", "proofBytes", "calldata"],
          "properties": {
            "pA": { "type": "array", "items": { "$ref": "#/definitions/dec" }, "minItems": 2, "maxItems": 2 },
            "pB": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/definitions/dec" }, "minItems": 2, "maxItems": 2 }, "minItems": 2, "maxItems": 2 },
            "pC": { "type": "array", "items": { "$ref": "#/definitions/dec" }, "minItems": 2, "maxItems": 2 },
            "pubSignals": { "type": "array", "items": { "$ref": "#/definitions/dec" }, "minItems": 6, "maxItems": 6 },
            "proofBytes": { "type": "string", "pattern": "^0x[0-9a-f]{512}$" },
            "calldata": { "type": "string", "pattern": "^0x[0-9a-f]{904}$" }
          }
        },
        "proofSolana": {
          "type": "object",
          "required": ["proofA", "proofB", "proofC", "proof", "publicInputs"],
          "properties": {
            "proofA": { "type": "string", "pattern": "^0x[0-9a-f]{128}$" },
            "proofB": { "type": "string", "pattern": "^0x[0-9a-f]{256}$" },
            "proofC": { "type": "string", "pattern": "^0x[0-9a-f]{128}$" },
            "proof": { "type": "string", "pattern": "^0x[0-9a-f]{512}$" },
            "publicInputs": { "type": "array", "items": { "$ref": "#/definitions/hex32" }, "minItems": 6, "maxItems": 6 }
          }
        }
      }
    }
  }
}
